# The backend uses the mssql SQL Server driver (not Windows ODBC).
# Supply approved SQL settings. SYSPRO_DSN is only a legacy database-name fallback.
SYSPRO_DSN=SysproCompanyAtd
SYSPRO_SERVER=ATD-SQL01.duys.co.za
SYSPRO_USER=
SYSPRO_PASSWORD=
SYSPRO_DATABASE=SysproCompanyAtd
SYSPRO_ENCRYPT=true
SYSPRO_TRUST_SERVER_CERTIFICATE=true

# Blank passwords are only valid if the approved SQL login accepts them.
# SYSPRO_ODBC is not used by this driver. Do not put SQL secrets in VITE_ variables.
# Optional bounded driver timeouts (milliseconds):
# SYSPRO_CONNECTION_TIMEOUT_MS=15000
# SYSPRO_REQUEST_TIMEOUT_MS=60000

PORT=3001
# Optional development launcher deadline for slow cold starts (milliseconds):
# DEV_STARTUP_TIMEOUT_MS=60000
CORS_ORIGIN=http://localhost:5173
